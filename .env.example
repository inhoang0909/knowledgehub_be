# ==============================================================================
# KnowledgeHub Backend - Environment Configuration Template
# Duplicate this file as .env and update the values according to your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Server
# ------------------------------------------------------------------------------
PORT=9000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# PostgreSQL Database (with pgvector extension)
# Default port for Docker pgvector service is 5433 on the host, 5432 in container
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://admin:123456@localhost:5433/knowbase_db?schema=public

# ------------------------------------------------------------------------------
# Authentication & JWT
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key
LOGIN_URL=http://your-sso-auth-service/api/login

# ------------------------------------------------------------------------------
# External Employee / User Search Service
# ------------------------------------------------------------------------------
EXTERNAL_USER_SEARCH_URL=http://your-employee-service/api/emp/getAllEmployeeBySearch

# ------------------------------------------------------------------------------
# Dify Platform API Configuration
# ------------------------------------------------------------------------------
DIFY_API_URL=http://localhost:8081/v1
DIFY_API_KEY=your_dify_dataset_api_key
DIFY_APP_API_KEY=your_dify_app_api_key

# Dify Admin Console Credentials (for automated app/conversation syncing)
DIFY_ADMIN_EMAIL=admin@example.com
DIFY_ADMIN_PASSWORD=your_dify_admin_password

# ------------------------------------------------------------------------------
# Dify PostgreSQL Database Direct Connection (for chatbot & dataset sync queries)
# ------------------------------------------------------------------------------
DIFY_DB_HOST=localhost
DIFY_DB_PORT=5432
DIFY_DB_USER=postgres
DIFY_DB_PASSWORD=your_dify_db_password
DIFY_DB_NAME=dify

# ------------------------------------------------------------------------------
# Redis Cache & Message Queue
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Ollama Embedding & Local LLM Service (Semantic Routing & Vectorization)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# File Processing & Document Conversion (Gotenberg & OCR)
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
GOTENBERG_URL=http://localhost:3003
GOTENBERG_TIMEOUT_MS=120000

OCR_API_URL=http://localhost:10002/ocr/run
OCR_TEMPLATE_ID=imageocr
OCR_TEMPERATURE=0
OCR_TIMEOUT_MS=180000
OCR_MAX_ATTEMPTS=2

